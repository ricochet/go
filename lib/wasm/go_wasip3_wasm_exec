# Runs a GOOS=wasip3 executable: wraps the module into a
# wasi:cli/command@0.3.0 component with wasm-tools, and runs it with Wasmtime.

set -e

wit="$(dirname "$0")/wasip3/wit"
wasm-tools component embed "$wit" "$1" -o "$1.embed.wasm"
wasm-tools component new "$1.embed.wasm" -o "$1.component.wasm"

case "$GOWASIRUNTIME" in
	"wasmtime" | "")
		# Component Model threading is needed with GOEXPERIMENT=wasmcoopthreads,
		# where goroutines also keep their frames on the wasm stack.
		exec wasmtime run -S p3 --dir=/ --env PWD="$PWD" --env PATH="$PATH" \
			-W component-model-async,component-model-async-stackful,component-model-threading \
			-W max-wasm-stack=8388608 -W async-stack-size=9437184 \
			${GOWASIRUNTIMEARGS:-} "$1.component.wasm" "${@:2}"
		;;
	*)
		echo "Unsupported Go WASI runtime for GOOS=wasip3: $GOWASIRUNTIME"
		exit 1
		;;
esac
